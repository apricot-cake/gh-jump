---
import Layout from '../layouts/Layout.astro';
import StoreBadge from '../components/StoreBadge.astro';
import { Image } from 'astro:assets';
import repositories from '../../public/screenshots/repositories.png';
import actions from '../../public/screenshots/actions.png';
import create from '../../public/screenshots/create.png';

---
<Layout>
  <section class="hero wrap" aria-labelledby="intro">

    <h1 id="intro"><span>GitHubへ</span><span>キーボードで。</span></h1>
    <p class="intro">リポジトリを選んで、目的のページへ。<br />PowerToysのコマンドパレット拡張機能。</p>
    <StoreBadge />

  </section>
  <section class="repository-demo wrap" aria-labelledby="repositories-heading">
    <h2 id="repositories-heading">リポジトリをすばやく探す</h2>
    <p class="section-description">自分のリポジトリを名前で検索できます。<br class="desktop-break" />プライベートリポジトリにも対応しています。</p>
    <figure>
      <Image src={repositories} alt="コマンドパレットのリポジトリ一覧。gh-jump以外のリポジトリ名は四角で隠しています。" widths={[640, 960, 1280, 1616]} sizes="(max-width: 800px) 92vw, 1000px" format="webp" loading="eager" fetchpriority="high" />

    </figure>
    <div class="key-route" aria-label="リポジトリを選ぶ操作"><kbd>gh</kbd><span>→</span><kbd>Enter</kbd><span>→</span><span>リポジトリ名</span><span>→</span><kbd>Enter</kbd></div>

  </section>
  <section class="feature wrap" aria-labelledby="actions-heading">
    <div class="feature-copy">

      <h2 id="actions-heading">目的のページへすぐに</h2>
      <p>選んだリポジトリから、開きたいページへ移動できます。</p>
      <p class="key-example"><span>行き先を選ぶ</span><span>→</span><kbd>Enter</kbd></p>
    </div>
    <figure><Image src={actions} alt="Repository top、Issues、Pull requests、Actionsなどが並ぶアクション一覧" widths={[640, 960, 1280]} sizes="(max-width: 800px) 92vw, 600px" format="webp" loading="lazy" /></figure>
  </section>
  <section class="feature reverse wrap" aria-labelledby="create-heading">
    <div class="feature-copy">

      <h2 id="create-heading">Createから作成画面へ</h2>
      <p>作成画面も、キーボードで開けます。</p>
      <p class="key-example"><span>Create</span><span>→</span><kbd>Enter</kbd><span>→</span><span>作成する項目</span><span>→</span><kbd>Enter</kbd></p>
    </div>
    <figure><Image src={create} alt="Create内のIssueとPull requestの候補一覧" widths={[640, 960, 1280]} sizes="(max-width: 800px) 92vw, 600px" format="webp" loading="lazy" /></figure>
  </section>
  <section class="setup wrap" aria-labelledby="setup-heading">
    <h2 id="setup-heading">使いはじめる</h2>
    <ol class="setup-steps">
      <li><h3>PowerToysとGitHub CLIを用意</h3><p>未導入なら<a href="https://learn.microsoft.com/windows/powertoys/">PowerToys</a>と<a href="https://cli.github.com/">GitHub CLI</a>をインストールします。コマンドパレットを有効にし、GitHub CLIでGitHubにログインします。</p></li>
      <li><h3>gh jumpをインストール</h3><p><a href="https://apps.microsoft.com/detail/9NN7GSPR8W9R">Microsoft Store</a>から入手し、コマンドパレットを再起動します。</p></li>
    </ol>
  </section>
</Layout>
