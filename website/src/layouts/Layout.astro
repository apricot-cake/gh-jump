---
import '@fontsource-variable/noto-sans-jp';
import '../styles/site.css';
interface Props { title?: string; description?: string; privacy?: boolean; }
const { title = 'gh jump — GitHubへキーボードで。', description = 'PowerToysのコマンドパレットから、GitHubのリポジトリを検索して目的のページへ移動する拡張機能。', privacy = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = `https://apricot-cake.com${base}${privacy ? 'privacy/' : ''}`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}icon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={`https://apricot-cake.com${base}screenshots/actions.png`} />
    <meta property="og:image:alt" content="gh jumpのリポジトリアクション一覧" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header wrap">
      <a class="brand" href={base} aria-label="gh jump ホーム"><img src={`${base}icon.png`} width="34" height="34" alt="" /><span>gh jump</span></a>
      <a class="github-link" href="https://github.com/apricot-cake/gh-jump" aria-label="gh jumpのGitHubリポジトリ"><img src={`${base}icons/mark-github.svg`} width="26" height="26" alt="" /></a>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
</body>
</html>
